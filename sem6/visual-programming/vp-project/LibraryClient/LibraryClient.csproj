      <DependentUpon>AddEditBookForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AddEditBookForm.resx">
      <DependentUpon>AddEditBookForm.cs</DependentUpon>
    </EmbeddedResource>

